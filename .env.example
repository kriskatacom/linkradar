DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linkradar
DB_USER=root
DB_PASSWORD=

API_HOST=127.0.0.1
API_PORT=3000
NODE_ENV=development

FRONTEND_URL=http://localhost:5173

# LAN development (optional). Do not commit a machine-specific IP.
# hostname -I
# LAN_ENABLED=true
# LAN_HOST=
# LAN_FRONTEND_URL=
# LAN_API_URL=
# Nginx should be the only LAN entry (80/443). Keep API_HOST=127.0.0.1
# unless you are debugging the API directly on the LAN (API_HOST=0.0.0.0).
# See docs/lan-development.md.

JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
AUTH_REFRESH_TOKEN_DAYS=30

AUTH_COOKIE_NAME=refresh_token
AUTH_COOKIE_PATH=/api/auth
# Host-only cookies (leave AUTH_COOKIE_DOMAIN unset) so LAN IPs work.
# localhost HTTP:
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# same-origin HTTPS via Nginx (website.local or https://<LAN_IP>):
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# split-origin https://website.local + https://api.local:
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_PARTITIONED=true
AUTH_RATE_LIMIT_MAX=200

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM_NAME=LinkRadar
MAIL_FROM_ADDRESS=noreply@linkradar.local

APP_URL=http://localhost:5173
API_URL=http://127.0.0.1:3000
# If the API runs inside Docker, use SMTP_HOST=mailpit instead of 127.0.0.1.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/api/auth/social/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://127.0.0.1:3000/api/auth/social/facebook/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://127.0.0.1:3000/api/auth/social/linkedin/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/auth/social/github/callback
